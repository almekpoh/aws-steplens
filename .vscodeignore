# Source — not needed in the package, only dist/extension.js matters
src/**
out/**

# Tests
test/**

# Examples
examples/**

# Config / tooling
.vscode/**
.vscode-test/**
eslint.config.js
tsconfig.json
esbuild.js

# Dev dependencies (esbuild bundles everything into dist/extension.js)
node_modules/**

# Webview sources (only vendor.js is needed at runtime)
webview/vendor-entry.js

# Dev / CI / tooling
.claude/**
.github/**

# Misc
**/*.map
**/*.ts
# NOTE: **/*.svg is intentionally NOT excluded here — media/aws-icons/*.svg
# must be included in the VSIX so the webview can load AWS service icons.
package-lock.json
.gitignore
NOTES.md
